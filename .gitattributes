# Language statistics: count project code, ignore third-party and non-code folders.
# (Folder-based vendoring replaces the previous extension whitelist, so project
#  sources — cpp/cppm/headers/cmake/glsl — count naturally.)

# Third-party code / assets
std/** linguist-vendored
third_party/** linguist-vendored
gltf_model/** linguist-vendored

# Non-code folders (docs, screenshots)
docs/** linguist-vendored
snapshot/** linguist-vendored

# Shell scripts must keep LF endings in the working tree (core.autocrlf=true
# would otherwise check them out as CRLF and break the shebang on POSIX).
*.sh text eol=lf
